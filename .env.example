# Copiar este archivo a ".env" y completar los valores reales.
# NUNCA subir el archivo ".env" al repositorio.

APP_ENV=development
APP_NAME=FactuTools
APP_VERSION=1.0.0
ORG_NAME=IPS Clinica Salud Florida
CLINIC_NAME=IPS Clinica Salud Florida
LOG_LEVEL=INFO

# Repositorio de GitHub usado para buscar actualizaciones (formato owner/repo)
GITHUB_REPO=

# Conexion a Microsoft SQL Server
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false